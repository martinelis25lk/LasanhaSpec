server {
    listen 80;
    server_name lasanhaspecs.duckdns.org;

    # Servir os arquivos do Frontend na raiz
    location / {
        root /var/www/lasanhaspec;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Repassar chamadas de API para o Backend (car-service)
    location /api/ {
        proxy_pass http://localhost:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Repassar chamadas para o market-service
    location /market/ {
        proxy_pass http://localhost:8081/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
